{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AetherDesk",
  "version": "1.0.0",
  "identifier": "com.aether.desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AetherDesk",
        "width": 1050,
        "height": 720,
        "minWidth": 1050,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English", "Italian"],
        "displayLanguageSelector": true,
        "startMenuFolder": "AetherDesk"
      }
    }
  }
}
