{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.mjs"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "vite": true,
  "eslint": true,
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "duplicates": "warn",
    "enumMembers": "warn"
  }
}
