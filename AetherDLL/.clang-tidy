# clang-tidy for AetherDLL — the C++ equivalent of `cargo clippy`.
#
# Philosophy: few checks, all actionable, all blocking (see
# cmake/Quality.cmake: --warnings-as-errors=*). A check that produces noise
# gets removed here, not ignored with scattered comments in the code.
#
# Groups:
#   bugprone-*      real bugs: use-after-move, narrowing, accidental copies,
#                   suspicious comparisons, wrong buffer sizes
#   cert-*          CERT C++ rules (security, UB)
#   concurrency-*   mt-unsafe, missing locks
#   performance-*   avoidable copies, by-value parameters, missing moves
#   misc-*          dead code / unused includes (selection)
#   modernize-*     only the ones that prevent bugs (nullptr, override, use-after-move)
#
# Excluded with reason:
#   bugprone-easily-swappable-parameters   too noisy on Win32/Steam APIs
#   bugprone-reserved-identifier           Win32 macros and __try
#   cert-err58-cpp                         static init with mutex/string is intentional
#   performance-avoid-endl                 no iostream in hot paths
#   misc-non-private-member-variables-in-classes  AetherCoreState is a data struct
#   misc-no-recursion                      VDF/KeyValues parsers are recursive by design
#   modernize-use-trailing-return-type     style, not correctness
#   modernize-avoid-c-arrays               fixed Win32 buffers (MAX_PATH)
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -bugprone-exception-escape,
  cert-*,
  -cert-err58-cpp,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  concurrency-*,
  performance-*,
  -performance-avoid-endl,
  misc-unused-using-decls,
  misc-unused-alias-decls,
  misc-redundant-expression,
  misc-misplaced-const,
  misc-static-assert,
  misc-definitions-in-headers,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-redundant-void-arg,
  modernize-use-bool-literals,
  readability-misleading-indentation,
  readability-redundant-string-cstr,
  readability-container-size-empty,
  readability-delete-null-pointer

# Only analyze our own code: no third-party headers (FetchContent
# downloads into out/build/_deps) and no generated protobuf.
HeaderFilterRegex: '^(?!.*(_deps|proto/generated|pb\.h)).*(AetherCore|AetherPayload|AetherXInput|common)[/\\].*'

WarningsAsErrors: '*'

CheckOptions:
  - key: bugprone-unused-return-value.CheckedFunctions
    value: '::std::async;::std::launder;::std::remove;::std::remove_if;::std::unique;::std::unique_ptr::release;::std::basic_string::empty;::std::vector::empty;::std::back_inserter;::std::distance;::std::find;::std::find_if;::std::lower_bound;::std::upper_bound;::std::max;::std::min;::std::move'
  - key: performance-unnecessary-value-param.AllowedTypes
    value: 'shared_ptr;unique_ptr'
  - key: misc-definitions-in-headers.HeaderFileExtensions
    value: 'h,hpp,inl'
